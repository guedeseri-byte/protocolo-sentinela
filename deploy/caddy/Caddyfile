{
	auto_https off
}

:80 {
	# Kiwix — Biblioteca offline (redireciona /biblioteca para /biblioteca/)
	redir /biblioteca /biblioteca/ permanent

	handle /biblioteca/* {
		reverse_proxy kiwix:8080
	}

	# Open WebUI — acessível na porta 3000 (subpath não funciona com Open WebUI)
	redir /ia http://{host}:3000 temporary
	redir /ia/ http://{host}:3000 temporary

	# Ollama — API de IA
	handle /ollama/* {
		uri strip_prefix /ollama
		reverse_proxy ollama:11434
	}

	# Kolibri — Educação
	redir /educacao /educacao/ permanent

	handle /educacao/* {
		uri strip_prefix /educacao
		reverse_proxy kolibri:8080
	}

	# Portal principal (fallback)
	reverse_proxy portal:8000
}
