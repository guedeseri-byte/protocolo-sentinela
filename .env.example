# ── Protocolo Sentinela — Configuração ──────────────────────────
# Copie este arquivo para .env e ajuste conforme necessário.

# Porta HTTP do servidor (padrão: 80)
SENTINELA_PORT=80

# Porta HTTPS (padrão: 443, requer certificado)
SENTINELA_PORT_HTTPS=443

# Nome da instância (exibido no portal)
SENTINELA_NOME=Protocolo Sentinela

# Região para mapas (usado na instalação de pacotes)
SENTINELA_REGIAO=sudeste

# Idioma principal
SENTINELA_IDIOMA=pt-BR
